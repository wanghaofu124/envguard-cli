{
  "name": "envguard-cli",
  "version": "0.1.0",
  "description": "Secure .env file diff tool with redaction and secret detection",
  "type": "module",
  "bin": {
    "envguard": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "env",
    "dotenv",
    "diff",
    "security",
    "cli",
    "secrets"
  ],
  "author": "wanghaofu124",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wanghaofu124/envguard-cli.git"
  },
  "homepage": "https://github.com/wanghaofu124/envguard-cli#readme",
  "bugs": {
    "url": "https://github.com/wanghaofu124/envguard-cli/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "chalk": "^5.4.1",
    "cli-table3": "^0.6.5",
    "commander": "^13.1.0",
    "ink": "^5.2.0",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/react": "^18.3.18",
    "tsup": "^8.4.0",
    "typescript": "^5.8.2",
    "vitest": "^2.1.9"
  }
}
